# Copy to apps/api/.env for local development. Never commit real secrets.
# Production refuses to boot without the required values (see Settings).
APP_ENV=development
APP_NAME=ATS
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/hireflow
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
MAX_RESUME_SIZE_BYTES=5242880
PRIVATE_UPLOAD_DIR=var/private_uploads
RESUME_STORAGE_BACKEND=local
RESUME_SIGNED_URL_EXPIRE_SECONDS=300
REDIS_URL=redis://localhost:6379/0
RESUME_PROCESSING_QUEUE_NAME=hireflow:resume-processing
RESUME_PROCESSING_MAX_RETRIES=3
RESUME_PROCESSING_RETRY_BASE_SECONDS=5
RESUME_PROCESSING_RETRY_MAX_SECONDS=60

# Set RESUME_STORAGE_BACKEND=r2 in environments that store resumes in Cloudflare R2.
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION_NAME=auto

# Comma-separated browser origins allowed to call the API.
# Empty (default) means same-origin only. Never use "*" in production.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
