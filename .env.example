RESUME_STORAGE_BACKEND=local
PRIVATE_UPLOAD_DIR=var/private_uploads
MAX_RESUME_SIZE_BYTES=5242880
RESUME_SIGNED_URL_EXPIRE_SECONDS=300
REDIS_URL=redis://localhost:6379/0
RESUME_PROCESSING_QUEUE_NAME=hireflow:resume-processing
RESUME_PROCESSING_MAX_RETRIES=3
RESUME_PROCESSING_RETRY_BASE_SECONDS=5
RESUME_PROCESSING_RETRY_MAX_SECONDS=60

# Set RESUME_STORAGE_BACKEND=r2 in environments that store resumes in Cloudflare R2.
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION_NAME=auto
